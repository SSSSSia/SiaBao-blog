# 前端 Dockerfile
#
# 注意：本镜像不再在容器内执行 Vite 构建，而是直接使用 CI（GitHub Actions）
# 预构建好的 react-ui/dist/。原因：云服务器内存较小（1-2G），在服务器上跑
# `npm run build`（尤其压缩 markdown/mermaid 大 chunk 时）会把内存吃满、整机
# thrashing 卡死。把构建搬到 CI runner（7G 内存）后，服务器只需 COPY 产物，
# 彻底避开内存瓶颈。因此部署流程必须先用 rsync/scp 把 dist/ 送到服务器，再
# 执行 docker compose build。

FROM nginx:alpine

# 复制 CI 预构建的产物（由部署流程在 build 前同步到本目录）
COPY react-ui/dist/ /usr/share/nginx/html/

# 复制自定义 Nginx 配置
COPY docker/nginx/frontend.conf /etc/nginx/conf.d/default.conf

# 暴露端口
EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
