# 前端 Dockerfile
# 多阶段构建：先构建，再使用轻量级 Nginx 镜像运行

# 阶段1: 构建阶段
FROM node:20-alpine AS builder

WORKDIR /app

# 复制 package.json 和 lock 文件
COPY react-ui/package*.json ./

# 安装依赖。使用 lockfile 保证云端构建版本稳定，缓存也更可靠。
RUN npm ci

# 复制源代码
COPY react-ui/ ./

# 构建生产版本
RUN npm run build

# 阶段2: 运行阶段 - 使用 Nginx 提供静态文件服务
FROM nginx:alpine

# 复制构建产物到 Nginx 目录
COPY --from=builder /app/dist /usr/share/nginx/html

# 复制自定义 Nginx 配置
COPY docker/nginx/frontend.conf /etc/nginx/conf.d/default.conf

# 暴露端口
EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
