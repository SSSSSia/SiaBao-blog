# Server Configuration
HOST=0.0.0.0
PORT=9090
DEBUG=false

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# JWT Configuration
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-secure-password

# File Upload Configuration
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=data/uploads

# AI/LLM Configuration for Summary Generation
SILICONFLOW_API_KEY=your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

# Explore / Knowledge Constellation (all optional — safe defaults, zero-config works)
EXPLORE_GITHUB_ENABLED=true
# Optional: GitHub PAT to raise rate limit from 60/hr to 5000/hr (use a fine-grained read-only token)
GITHUB_TOKEN=
EXPLORE_CACHE_TTL=21600
EXPLORE_GITHUB_FALLBACK_SCRAPE=false
EXPLORE_MAX_NODES=120
