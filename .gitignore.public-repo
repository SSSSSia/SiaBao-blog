# 公开仓库 .gitignore 配置
# 用于双仓库架构：排除所有敏感数据和内容

# ==================== 数据内容（使用私有仓库）====================
# 排除所有真实数据，这些内容由私有仓库管理
server/data/posts/*
!server/data/posts/.gitkeep
!server/data/posts/example-*.md
server/data/index.json
server/data/likes.json
server/data/comments.json
server/data/views.json
server/data/config.json
server/data/uploads/

# ==================== 环境配置 ====================
server/.env
server/.env.local
server/.env.*.local

# ==================== 其他敏感文件 ====================
*.key
*.pem
credentials.json
secrets/

# ==================== 子模块内容 ====================
# 如果使用 Git Submodule 方案
/content/

# ==================== 备份文件 ====================
backups/
*.backup
*.bak

# ==================== 临时数据 ====================
temp/
tmp/
*.tmp
